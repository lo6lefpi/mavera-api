diff --git a/supabase/functions/tests/services/fake-repository.ts b/supabase/functions/tests/services/fake-repository.ts
new file mode 100644
index 0000000..308f158
--- /dev/null
+++ b/supabase/functions/tests/services/fake-repository.ts
@@ -0,0 +1,80 @@
+// deno-lint-ignore-file require-await -- faux dépôt : mêmes signatures async que le vrai, sans attente réelle.
+/** Faux dépôt pour les tests de services et d'API : uniquement pour les tests. */
+import type { CheckoutAttempt, CheckoutQuote, CheckoutRepository, Eligibility, PaymentProof, RefundResult,
+  RefundState, RefundSync, SignupInput, StripeSubscriptionRecord, SubscriptionState } from '../../_shared/services/ports.ts';
+
+/** Mêmes règles que les fonctions SQL, en mémoire. */
+export class FakeRepository implements CheckoutRepository {
+  attempts = new Map<string, CheckoutAttempt>();
+  eligibility: Eligibility = 'new';
+  token: string | null = null;
+  completeCalls = 0;
+  failOnce = false;
+  reasons = new Map<string, string>();
+  refundStatus = new Map<string, string>();
+  states: SubscriptionState[] = [];
+  checkEligibility(): Promise<Eligibility> { return Promise.resolve(this.eligibility); }
+  async createAttempt(i: SignupInput, quote: CheckoutQuote, requestFingerprint: string) {
+    if (await this.openAttemptFor(i.email)) throw new Error('P0005 tentative ouverte');
+    const attempt: CheckoutAttempt = { id: i.attemptId, createdAt: new Date().toISOString(),
+      email: i.email, phone: i.phone, displayName: i.displayName,
+      booksUpToDate: i.booksUpToDate, usesQuickbooks: i.usesQuickbooks,
+      estimatedTransactions: i.estimatedTransactions, quote,
+      stripeSessionId: null, stripeCustomerId: null, stripePaymentIntentId: null,
+      stripeSubscriptionId: null, stripePriceId: null, stripeStatus: null, paidAmountCents: null,
+      paidAt: null, completedAt: null, rejectedAt: null, abandonedAt: null, refundId: null, requestFingerprint };
+    this.attempts.set(i.attemptId, attempt); return attempt;
+  }
+  getAttempt(id: string) { return Promise.resolve(this.attempts.get(id) ?? null); }
+  openAttemptFor(email: string) {
+    const open = [...this.attempts.values()].find(a => a.email === email &&
+      !a.completedAt && !a.rejectedAt && !a.abandonedAt);
+    return Promise.resolve(open?.id ?? null);
+  }
+  async abandon(id: string) {
+    const a = this.attempts.get(id)!;
+    if (a.paidAt || this.token) throw new Error('P0001 tentative payée ou verrouillée');
+    a.abandonedAt = new Date().toISOString();
+  }
+  async saveSession(id: string, sessionId: string) { this.attempts.get(id)!.stripeSessionId = sessionId; }
+  async claim(_id: string, token: string) { if (this.token) return false; this.token = token; return true; }
+  async savePayment(id: string, _token: string, proof: PaymentProof) {
+    const a = this.attempts.get(id)!;
+    a.stripeCustomerId = proof.customerId; a.stripePaymentIntentId = proof.paymentIntentId;
+    a.paidAt = proof.paidAt; a.paidAmountCents = proof.amountPaidCents;
+  }
+  async saveSubscription(id: string, _token: string, s: StripeSubscriptionRecord) {
+    const a = this.attempts.get(id)!;
+    a.stripeSubscriptionId = s.subscriptionId; a.stripePriceId = s.priceId; a.stripeStatus = s.status;
+  }
+  async complete(id: string) {
+    this.completeCalls++;
+    if (this.failOnce) { this.failOnce = false; throw new Error('temporary SQL failure'); }
+    this.attempts.get(id)!.completedAt = new Date().toISOString();
+    return 'client_id';
+  }
+  async reject(id: string, _token: string, refund: RefundResult, reason: string) {
+    const a = this.attempts.get(id)!;
+    // Mêmes exigences que checkout_attempt_reject.
+    if (!['pending', 'succeeded'].includes(refund.status) || refund.amountCents !== a.paidAmountCents) {
+      throw new Error('22023 remboursement non conforme');
+    }
+    a.rejectedAt = new Date().toISOString(); a.refundId = refund.refundId;
+    this.reasons.set(id, reason); this.refundStatus.set(refund.refundId, refund.status);
+  }
+  async release() { this.token = null; }
+  async applySubscriptionState(state: SubscriptionState) { this.states.push(state); return true; }
+  /** Mêmes règles que checkout_attempt_refund_status. */
+  async updateRefundStatus(state: RefundState): Promise<RefundSync> {
+    const a = this.attempts.get(state.attemptId);
+    if (!a) return 'unknown_attempt';
+    if (a.refundId === state.refundId) {
+      if (!(this.refundStatus.get(state.refundId) === 'succeeded' && state.status === 'pending')) {
+        this.refundStatus.set(state.refundId, state.status);
+      }
+      return 'updated';
+    }
+    if (!a.rejectedAt && ['pending', 'succeeded', 'requires_action'].includes(state.status)) return 'not_recorded';
+    return 'ignored';
+  }
+}
diff --git a/supabase/migrations/20261020001000_checkout_attempt_get.sql b/supabase/migrations/20261020001000_checkout_attempt_get.sql
new file mode 100644
index 0000000..db3e4b5
--- /dev/null
+++ b/supabase/migrations/20261020001000_checkout_attempt_get.sql
@@ -0,0 +1,11 @@
+-- Lecture d'une tentative par les Edge Functions (service_role seulement).
+-- Tous les accès des fonctions passent par des fonctions SQL : un seul chemin,
+-- facile à tester et à restreindre.
+create function public.checkout_attempt_get(p_id uuid)
+returns setof public.checkout_attempts
+language sql stable security definer set search_path = '' as $$
+  select * from public.checkout_attempts where id = p_id
+$$;
+
+revoke execute on function public.checkout_attempt_get(uuid) from public, anon, authenticated;
+grant execute on function public.checkout_attempt_get(uuid) to service_role;
diff --git a/supabase/migrations/20261020001100_signup_protection.sql b/supabase/migrations/20261020001100_signup_protection.sql
new file mode 100644
index 0000000..225d1b3
--- /dev/null
+++ b/supabase/migrations/20261020001100_signup_protection.sql
@@ -0,0 +1,133 @@
+-- Protection de l'inscription publique (revue du point 2)
+--   1. Empreinte des choix : une tentative ne peut pas être reprise avec d'autres choix.
+--   2. La base n'abandonne plus seule une tentative : seul Stripe sait si une session
+--      a été payée (paiement en traitement, webhook en retard). Le service expire la
+--      session chez Stripe avant d'abandonner, et le webhook checkout.session.expired
+--      abandonne les sessions expirées.
+--   3. Suivi des remboursements : un remboursement de l'application pas encore
+--      enregistré n'est plus ignoré (Stripe renvoie l'événement).
+--   4. Limite d'appels de l'API publique, sans conserver de courriel ni d'adresse IP.
+
+-- -----------------------------------------------------------------------------
+-- 1 et 2. Création d'une tentative
+-- -----------------------------------------------------------------------------
+alter table public.checkout_attempts
+  add column request_fingerprint text check (request_fingerprint ~ '^[0-9a-f]{64}$');
+comment on column public.checkout_attempts.request_fingerprint is
+  'SHA-256 des choix de la demande (forfait, facturation, mois, volume, réponses Trajet, coordonnées). Une reprise avec d''autres choix est refusée.';
+
+drop function public.checkout_attempt_create(uuid, text, text, text, boolean, boolean, integer, jsonb);
+
+create function public.checkout_attempt_create(
+  p_id uuid, p_email text, p_phone text, p_display_name text,
+  p_books_up_to_date boolean, p_uses_quickbooks boolean,
+  p_estimated_transactions integer, p_quote jsonb, p_request_fingerprint text default null
+) returns void language plpgsql security definer set search_path = '' as $$
+declare
+  v_email text := lower(trim(p_email));
+  v_open  uuid;
+begin
+  case public.check_signup_eligibility(v_email, p_phone)
+    when 'active', 'refused' then
+      raise exception 'Inscription refusée' using errcode = 'P0004';
+    when 'returning' then
+      raise exception 'Ancien client : réouverture par l''application' using errcode = 'P0006';
+    else null;  -- 'new' ou 'review' (même téléphone : vérifié à l'appel de bienvenue)
+  end case;
+  if not private.is_valid_checkout_quote(p_quote) then
+    raise exception 'Récapitulatif incomplet ou incohérent' using errcode = '22023';
+  end if;
+
+  -- Jamais d'abandon automatique ici : le service vérifie d'abord la session chez Stripe.
+  select id into v_open from public.checkout_attempts
+   where email = v_email and completed_at is null and rejected_at is null and abandoned_at is null;
+  if v_open is not null then
+    raise exception 'Une inscription est déjà en cours pour ce courriel'
+      using errcode = 'P0005', detail = v_open::text;
+  end if;
+
+  insert into public.checkout_attempts
+    (id, email, phone, display_name, books_up_to_date, uses_quickbooks, estimated_transactions,
+     granted_quote, request_fingerprint)
+  values (p_id, v_email, trim(p_phone), trim(p_display_name), p_books_up_to_date,
+          p_uses_quickbooks, p_estimated_transactions, p_quote, p_request_fingerprint);
+end $$;
+
+-- -----------------------------------------------------------------------------
+-- 3. Suivi d'un remboursement : statut relu chez Stripe par le service
+--   updated         : statut enregistré
+--   not_recorded    : remboursement accepté de cette tentative, refus pas encore
+--                     enregistré → le webhook répond en erreur, Stripe renverra
+--   ignored         : ancien remboursement échoué ou remplacé, jamais enregistré
+--   unknown_attempt : tentative inconnue (purgée, autre environnement) → ignoré
+-- -----------------------------------------------------------------------------
+drop function public.checkout_attempt_refund_status(text, text);
+
+create function public.checkout_attempt_refund_status(p_attempt_id uuid, p_refund_id text, p_status text)
+returns text language plpgsql security definer set search_path = '' as $$
+declare
+  a public.checkout_attempts%rowtype;
+begin
+  if p_status is null or p_status not in ('pending', 'succeeded', 'failed', 'canceled', 'requires_action') then
+    raise exception 'Statut de remboursement inconnu : %', p_status using errcode = '22023';
+  end if;
+  select * into a from public.checkout_attempts where id = p_attempt_id for update;
+  if not found then return 'unknown_attempt'; end if;
+  if a.refund_id = p_refund_id then
+    update public.checkout_attempts set refund_status = p_status
+     where id = p_attempt_id
+       and not (refund_status = 'succeeded' and p_status = 'pending');  -- jamais revenir en arrière
+    return 'updated';
+  end if;
+  -- Un refus est enregistré seulement avec un remboursement en cours ou réussi.
+  if a.rejected_at is null and p_status in ('pending', 'succeeded', 'requires_action') then
+    return 'not_recorded';
+  end if;
+  return 'ignored';
+end $$;
+
+-- -----------------------------------------------------------------------------
+-- 4. Limite d'appels : fenêtre fixe; la clé est hachée (aucun courriel ni IP gardé)
+-- -----------------------------------------------------------------------------
+create table private.rate_limit_hits (
+  key_hash     text        not null,
+  window_start timestamptz not null,
+  hits         integer     not null,
+  primary key (key_hash, window_start)
+);
+create index rate_limit_hits_window on private.rate_limit_hits (window_start);
+alter table private.rate_limit_hits enable row level security;
+
+create function public.rate_limit_hit(p_key text, p_limit integer, p_window_seconds integer)
+returns boolean language plpgsql security definer set search_path = '' as $$
+declare
+  v_start timestamptz;
+  v_hits  integer;
+begin
+  if p_key is null or p_limit is null or p_limit < 1 or p_window_seconds is null
+     or p_window_seconds < 1 or p_window_seconds > 86400 then
+    raise exception 'Limite d''appels invalide' using errcode = '22023';
+  end if;
+  v_start := to_timestamp(floor(extract(epoch from now()) / p_window_seconds) * p_window_seconds);
+  insert into private.rate_limit_hits as r (key_hash, window_start, hits)
+  values (encode(sha256(convert_to(p_key, 'UTF8')), 'hex'), v_start, 1)
+  on conflict (key_hash, window_start) do update set hits = r.hits + 1
+  returning hits into v_hits;
+  delete from private.rate_limit_hits where window_start < now() - interval '2 days';
+  return v_hits <= p_limit;
+end $$;
+
+-- -----------------------------------------------------------------------------
+-- Privilèges : rôle service seulement
+-- -----------------------------------------------------------------------------
+revoke all on private.rate_limit_hits from public, anon, authenticated;
+revoke execute on function
+  public.checkout_attempt_create(uuid, text, text, text, boolean, boolean, integer, jsonb, text),
+  public.checkout_attempt_refund_status(uuid, text, text),
+  public.rate_limit_hit(text, integer, integer)
+from public, anon, authenticated;
+grant execute on function
+  public.checkout_attempt_create(uuid, text, text, text, boolean, boolean, integer, jsonb, text),
+  public.checkout_attempt_refund_status(uuid, text, text),
+  public.rate_limit_hit(text, integer, integer)
+to service_role;
