# Copier en supabase/functions/.env (jamais commité). Clés du BAC À SABLE Stripe seulement.
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournies automatiquement par `supabase start`.
STRIPE_SECRET_KEY=sk_test_...
# Affiché par : stripe listen --forward-to localhost:54321/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Origines autorisées à appeler public-api (et adresses de retour après paiement).
PUBLIC_SITE_ORIGIN=http://localhost:3000
PUBLIC_PORTAL_ORIGIN=http://localhost:5173
# Antirobot : désactivé en local (JAMAIS en production).
CAPTCHA_DISABLED=true
# Production : vraie clé secrète Cloudflare Turnstile (elle passe avant CAPTCHA_DISABLED).
# Pour essayer Turnstile en local : clé de test « toujours réussi » 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=
